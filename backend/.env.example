# [BUG-002 FIX] Exemple de configuration - copier ce fichier en .env et remplir les vraies valeurs
# IMPORTANT : Ne JAMAIS commiter le fichier .env, seulement .env.example

PORT=3000

# Base de données PostgreSQL
DB_NAME=nelya_db
DB_USER=nelya_user
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_HOST=postgres
DB_PORT=5432

# JWT - Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_real_secret_here

# Environnement
NODE_ENV=production

# CORS - Mettre l'URL de votre frontend en production
ALLOWED_ORIGIN=http://localhost:4200
