# ============================================
# DOCKERFILE DE PRODUCTION - BACKEND
# ============================================

FROM node:20-alpine AS base

# Installer des dépendances système pour la sécurité
RUN apk add --no-cache dumb-init

# Créer un utilisateur non-root pour la sécurité
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

WORKDIR /app

# ============================================
# ÉTAPE 1: Installation des dépendances
# ============================================
FROM base AS dependencies

COPY package*.json ./

# Installer UNIQUEMENT les dépendances de production
RUN npm ci --only=production && \
    npm cache clean --force

# ============================================
# ÉTAPE 2: Build de l'application
# ============================================
FROM base AS build

COPY package*.json ./
RUN npm ci

COPY . .

# Validation et tests (optionnel, décommenter si vous avez des tests)
# RUN npm run test

# ============================================
# ÉTAPE 3: Image finale de production
# ============================================
FROM base AS production

# Copier les dépendances de production
COPY --from=dependencies --chown=nodejs:nodejs /app/node_modules ./node_modules

# Copier le code source
COPY --chown=nodejs:nodejs . .

# Variables d'environnement par défaut (surchargées par docker-compose)
ENV NODE_ENV=production \
    PORT=3000

# Changer vers l'utilisateur non-root
USER nodejs

EXPOSE 3000

# Healthcheck intégré à l'image
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/api/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Utiliser dumb-init pour gérer correctement les signaux
ENTRYPOINT ["dumb-init", "--"]

# Démarrer l'application
CMD ["node", "src/server.js"]
