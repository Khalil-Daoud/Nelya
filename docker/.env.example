# Copiez ce fichier en ".env" dans le même dossier, puis remplissez-le.
# Ne commitez jamais le fichier .env.

DB_USER=nelya_user
DB_NAME=nelya_db
# openssl rand -base64 24
DB_PASSWORD=remplacez_moi_par_un_mot_de_passe_long

# openssl rand -hex 32  (64 caractères hexadécimaux)
JWT_SECRET=remplacez_moi_par_64_caracteres_hexadicimaux_minimum_____

# Origine du navigateur (CORS). En local : le ng serve. En production : https://votre-domaine.tn
FRONTEND_URL=http://localhost:4200
