# ============================================
# VARIABLES D'ENVIRONNEMENT DE PRODUCTION
# ============================================
# ⚠️ NE JAMAIS COMMITER CE FICHIER AVEC DES VRAIES VALEURS
# ⚠️ Copier ce fichier en .env.production et remplir avec les vraies valeurs

# Base de données PostgreSQL
DB_USER=nelya_prod_user
DB_PASSWORD=CHANGEZ_MOI_AVEC_UN_MOT_DE_PASSE_FORT_ET_ALEATOIRE
DB_NAME=nelya_prod_db

# JWT Secret (Générer avec: openssl rand -hex 64)
JWT_SECRET=CHANGEZ_MOI_AVEC_UNE_CLE_FORTE_ET_ALEATOIRE_DE_128_CARACTERES

# URL Frontend (votre domaine)
FRONTEND_URL=https://votre-domaine.com

# ============================================
# COMMENT GÉNÉRER DES SECRETS FORTS
# ============================================

# Pour DB_PASSWORD (32 caractères):
# openssl rand -base64 32

# Pour JWT_SECRET (128 caractères):
# openssl rand -hex 64

# ============================================
# BONNES PRATIQUES
# ============================================
# 1. Utiliser un gestionnaire de secrets en production:
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - HashiCorp Vault
#    - Docker Secrets
#
# 2. Ne JAMAIS commiter .env.production dans Git
#
# 3. Utiliser des secrets différents pour chaque environnement
#
# 4. Changer les secrets régulièrement (rotation)
#
# 5. Limiter l'accès aux secrets (principe du moindre privilège)
